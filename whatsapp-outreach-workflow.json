{
  "name": "WhatsApp Lead Outreach (CSV -> Cloud API)",
  "nodes": [
    {
      "parameters": {},
      "id": "f1000000-0000-4000-8000-000000000001",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-220, 300]
    },
    {
      "parameters": {
        "fileSelector": "/data/agartala_leads.csv",
        "options": {}
      },
      "id": "f1000000-0000-4000-8000-000000000002",
      "name": "Read Leads File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "operation": "csv",
        "options": {}
      },
      "id": "f1000000-0000-4000-8000-000000000003",
      "name": "Parse CSV",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "jsCode": "// ---- Prepare Leads: clean, normalise, dedupe, daily cap ----\n// Input columns expected (see data/leads_template.csv):\n//   Business Name, Category, Phone, Website, Rating, Reviews, Status, Opportunity / What to pitch\n\nconst seen = new Set();\nconst out = [];\nconst MAX_PER_RUN = 40; // safety cap per run - keep small!\n\nfor (const item of $input.all()) {\n  const r = item.json;\n\n  // Skip rows already contacted\n  const status = String(r['Status'] ?? '').trim().toLowerCase();\n  if (status === 'sent' || status === 'replied' || status === 'do_not_contact') continue;\n\n  // Normalise phone to E.164 (+91XXXXXXXXXX)\n  let phone = String(r['Phone'] ?? '').trim();\n  if (!phone || phone === '-' || phone === 'nan') continue;\n  phone = phone.replace(/[\\s-]/g, '');\n  if (/^0\\d{10}$/.test(phone)) phone = '+91' + phone.slice(1);\n  else if (/^\\d{10}$/.test(phone)) phone = '+91' + phone;\n  else if (/^91\\d{10}$/.test(phone)) phone = '+' + phone;\n  if (!/^\\+91\\d{10}$/.test(phone)) continue; // skip unrecognised / non-Indian numbers\n\n  if (seen.has(phone)) continue; // dedupe\n  seen.add(phone);\n\n  out.push({\n    json: {\n      name: String(r['Business Name'] ?? '').trim(),\n      category: String(r['Category'] ?? ''),\n      to: phone,\n      pitch: String(r['Opportunity / What to pitch'] ?? ''),\n      source: 'csv'\n    }\n  });\n}\n\nif (out.length > MAX_PER_RUN) out.length = MAX_PER_RUN;\n\nif (out.length === 0) {\n  throw new Error('No usable leads found. Check the CSV (phones missing or all marked sent).');\n}\n\nreturn out;"
      },
      "id": "f1000000-0000-4000-8000-000000000004",
      "name": "Prepare Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "options": {
          "batchSize": 1
        }
      },
      "id": "f1000000-0000-4000-8000-000000000005",
      "name": "One at a Time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/YOUR_PHONE_NUMBER_ID/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"messaging_product\": \"whatsapp\", \"to\": \"{{ $json.to }}\", \"type\": \"template\", \"template\": { \"name\": \"lead_intro\", \"language\": { \"code\": \"en\" }, \"components\": [ { \"type\": \"body\", \"parameters\": [ { \"type\": \"text\", \"text\": \"{{ $json.name }}\" }, { \"type\": \"text\", \"text\": \"{{ $json.pitch }}\" } ] } ] } }",
        "options": {
          "timeout": 20000
        }
      },
      "id": "f1000000-0000-4000-8000-000000000006",
      "name": "Send WhatsApp Template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c1000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.error ? false : true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f1000000-0000-4000-8000-000000000007",
      "name": "Sent OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Log",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $now.toISO() }}",
            "Business": "={{ $('Prepare Leads').item.json.name }}",
            "Phone": "={{ $('Prepare Leads').item.json.to }}",
            "Category": "={{ $('Prepare Leads').item.json.category }}",
            "Status": "={{ $json.error ? 'failed: ' + ($json.error.message || 'unknown') : 'sent' }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "f1000000-0000-4000-8000-000000000008",
      "name": "Log to Google Sheet (optional)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1340, 100],
      "disabled": true
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "interval": {
          "field": "seconds",
          "secondsInterval": 45
        }
      },
      "id": "f1000000-0000-4000-8000-000000000009",
      "name": "Wait 45s (anti-ban delay)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1340, 280]
    }
  ],
  "connections": {
